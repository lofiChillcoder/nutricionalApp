<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="600.0" prefWidth="760.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="nutricionalappfx.controlador.FXMLFormularioPacienteController">
   <children>
      <BorderPane layoutX="180.0" layoutY="14.0" prefHeight="200.0" prefWidth="200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <top>
            <HBox alignment="CENTER_LEFT" prefHeight="80.0" style="-fx-background-color: #064E3B;" BorderPane.alignment="CENTER_LEFT">
               <padding>
                  <Insets left="40.0" right="40.0" />
               </padding>
               <children>
                  <Label text="Registrar paciente" textFill="#faf9f9">
                     <font>
                        <Font name="Segoe UI Bold" size="22.0" />
                     </font>
                  </Label>
                  <Pane prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
                  <Button mnemonicParsing="false" onAction="#handlerRegresarAPrincipal" style="-fx-background-color: black; -fx-background-radius: 20; -fx-cursor: hand; -fx-border-color: white; -fx-border-radius: 20;" text="Regresar" textFill="#faf4f4">
                     <font>
                        <Font size="13.0" />
                     </font>
                     <padding>
                        <Insets bottom="6.0" left="16.0" right="16.0" top="6.0" />
                     </padding>
                  </Button>
               </children>
            </HBox>
         </top>
         <center>
            <VBox prefHeight="200.0" prefWidth="100.0" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 16;" BorderPane.alignment="CENTER">
               <padding>
                  <Insets bottom="30.0" left="40.0" right="40.0" top="25.0" />
               </padding>
               <children>
                  <GridPane hgap="25.0" vgap="18.0">
                    <columnConstraints>
                      <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" percentWidth="50.0" prefWidth="100.0" />
                      <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" percentWidth="50.0" prefWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                     <children>
                        <VBox prefHeight="200.0" prefWidth="100.0">
                           <children>
                              <Label text="Nombre:" />
                              <TextField fx:id="txtNombrePaciente" />
                           </children>
                        </VBox>
                        <VBox prefHeight="200.0" prefWidth="100.0" GridPane.columnIndex="1">
                           <children>
                              <Label text="Apellido paterno:" />
                              <TextField fx:id="txtApellidoPaternoPaciente" />
                           </children>
                        </VBox>
                        <VBox prefHeight="200.0" prefWidth="100.0" GridPane.rowIndex="1">
                           <children>
                              <Label text="Apellido materno:" />
                              <TextField fx:id="txtApellidoMaternoPaciente">
                                 <VBox.margin>
                                    <Insets />
                                 </VBox.margin>
                              </TextField>
                           </children>
                           <GridPane.margin>
                              <Insets top="20.0" />
                           </GridPane.margin>
                        </VBox>
                        <VBox prefHeight="200.0" prefWidth="100.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                           <children>
                              <Label text="Fecha de nacimiento:" />
                              <DatePicker fx:id="datepFechaNacPaciente" prefHeight="26.0" prefWidth="366.0" />
                           </children>
                        </VBox>
                        <VBox prefHeight="200.0" prefWidth="100.0" spacing="2.0" GridPane.rowIndex="2">
                           <children>
                              <Label text="Sexo:" />
                              <RadioButton fx:id="rbMasculino" mnemonicParsing="false" text="Masculino" />
                              <RadioButton fx:id="rbFemenino" mnemonicParsing="false" text="Femenino" />
                           </children>
                           <padding>
                              <Insets top="40.0" />
                           </padding>
                        </VBox>
                        <VBox prefHeight="200.0" prefWidth="100.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                           <children>
                              <Label text="Teléfono:" />
                              <TextField fx:id="txtTelefonoPaciente" />
                           </children>
                        </VBox>
                        <VBox prefHeight="200.0" prefWidth="100.0" GridPane.rowIndex="3">
                           <children>
                              <Label text="Altura(en cm):" />
                              <TextField fx:id="txtAlturaPaciente" />
                           </children>
                           <GridPane.margin>
                              <Insets top="40.0" />
                           </GridPane.margin>
                           <padding>
                              <Insets top="40.0" />
                           </padding>
                        </VBox>
                        <VBox prefHeight="200.0" prefWidth="100.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                           <children>
                              <Label text="Peso inicial:" />
                              <TextField fx:id="txtPesoInicialPaciente" />
                           </children>
                           <GridPane.margin>
                              <Insets top="40.0" />
                           </GridPane.margin>
                        </VBox>
                        <VBox prefHeight="200.0" prefWidth="100.0" GridPane.rowIndex="4">
                           <children>
                              <Label text="Correo electrónico:" />
                              <TextField fx:id="txtCorreoPaciente" />
                           </children>
                           <GridPane.margin>
                              <Insets top="80.0" />
                           </GridPane.margin>
                        </VBox>
                     </children>
                  </GridPane>
               </children>
            </VBox>
         </center>
         <bottom>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" style="-fx-background-color: white;" BorderPane.alignment="CENTER">
               <children>
                  <Button mnemonicParsing="false" onAction="#handlerRegistrarPaciente" style="-fx-background-color: #064E3B; -fx-background-radius: 16;" text="Registrar paciente" textFill="#f7f2f2">
                     <HBox.margin>
                        <Insets />
                     </HBox.margin>
                     <padding>
                        <Insets bottom="6.0" left="16.0" right="16.0" top="6.0" />
                     </padding>
                     <font>
                        <Font name="Segoe UI" size="14.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
         </bottom>
      </BorderPane>
   </children>
</AnchorPane>
